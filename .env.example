# Copy to .env and fill values:
#   cp .env.example .env

# Required for live (non-mock) LLM runs
GEMINI_API_KEY=

# Optional: override model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: deterministic simulation reference date (ISO)
# If unset, the app uses (max order_date in orders.csv) + 7 days.
REFERENCE_DATE=2026-03-03
